#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$ROOT"

LOG_DIR="$ROOT/build/demo-logs"
SERVER_LOG="$ROOT/build/mapaf-demo-server.log"
SERVER_PID_FILE="$ROOT/build/mapaf-demo-server.pid"
DEMO_PORT="${MAPAF_DEMO_PORT:-8080}"
OPEN_REPORTS="${OPEN_REPORTS:-true}"
HEADLESS="${HEADLESS:-false}"

mkdir -p "$LOG_DIR"

CAPABILITIES=(
  "AI Automation Generation"
  "Mobile Quality Engineering"
  "AI Locator Intelligence"
  "Web Quality Engineering"
  "API Quality Engineering"
  "Performance Engineering"
  "Evidence Hub"
  "Enterprise Command Center"
)

usage() {
  cat <<'USAGE'
MAPAF Enterprise Guided Experience

Usage:
  ./mapaf-demo ai
  ./mapaf-demo mobile
  ./mapaf-demo healing
  ./mapaf-demo playwright
  ./mapaf-demo api
  ./mapaf-demo performance
  ./mapaf-demo allure
  ./mapaf-demo dashboard
  ./mapaf-demo guided
  ./mapaf-demo serve
  ./mapaf-demo stop-server
  ./mapaf-demo status

Options through environment variables:
  OPEN_REPORTS=false     Do not open browser reports
  HEADLESS=true          Run browser capability in headless mode
  MAPAF_DEMO_PORT=8090   Use a different local HTTP port
  STORY_FILE=<path>      Override the guided AI-generation story
USAGE
}

line() {
  printf '%*s\n' 72 '' | tr ' ' '='
}

banner() {
  local number="$1"
  local name="$2"
  local value="$3"

  echo
  line
  echo "              MAPAF ENTERPRISE QUALITY ENGINEERING PLATFORM"
  line
  printf "  Capability %-3s : %s\n" "$number" "$name"
  printf "  Business Value  : %s\n" "$value"
  line
  echo
}

navigator() {
  local active="$1"
  local completed="${2:-0}"

  echo "  MAPAF Capability Navigator"
  echo "  ----------------------------------------------------------------"

  local index
  for index in "${!CAPABILITIES[@]}"; do
    local display=$((index + 1))
    local marker="○"

    if (( display <= completed )); then
      marker="✓"
    elif (( display == active )); then
      marker="▶"
    fi

    printf "  %s %d. %s\n" "$marker" "$display" "${CAPABILITIES[$index]}"
  done

  echo
}

task_exists() {
  ./gradlew tasks --all --console=plain 2>/dev/null \
    | grep -qE "^${1}[[:space:]-]"
}

run_gradle() {
  local capability_key="$1"
  shift

  local log_file="$LOG_DIR/${capability_key}-$(date +%Y%m%d-%H%M%S).log"

  echo "  Executing MAPAF capability..."
  echo "  Engineering log: ${log_file#$ROOT/}"
  echo

  if "$@" >"$log_file" 2>&1; then
    echo "  ✓ Capability execution completed"
    echo "  ✓ Evidence publishing completed"
    echo
  else
    echo "  ✗ Capability execution failed"
    echo
    echo "  Last 60 log lines:"
    tail -60 "$log_file"
    return 1
  fi
}

complete() {
  local name="$1"
  local next="${2:-Enterprise Command Center}"

  line
  printf "  Capability Complete : %s\n" "$name"
  echo "  Evidence Status     : PUBLISHED"
  printf "  Proceeding To       : %s\n" "$next"
  line
  echo
}

start_server() {
  mkdir -p build

  if [ -f "$SERVER_PID_FILE" ]; then
    local existing_pid
    existing_pid="$(cat "$SERVER_PID_FILE" 2>/dev/null || true)"

    if [ -n "$existing_pid" ] && kill -0 "$existing_pid" 2>/dev/null; then
      echo "MAPAF Evidence Server already running:"
      echo "http://127.0.0.1:${DEMO_PORT}/dashboard/reports/index.html"
      return 0
    fi
  fi

  rm -f "$SERVER_LOG"

  nohup python3 -m http.server "$DEMO_PORT" \
    --bind 127.0.0.1 \
    --directory "$ROOT" \
    >"$SERVER_LOG" 2>&1 &

  local server_pid=$!
  echo "$server_pid" >"$SERVER_PID_FILE"

  sleep 2

  if ! kill -0 "$server_pid" 2>/dev/null; then
    echo "ERROR: MAPAF Evidence Server failed to start."
    cat "$SERVER_LOG"
    return 1
  fi

  if ! curl -fsS \
    "http://127.0.0.1:${DEMO_PORT}/dashboard/reports/index.html" \
    >/dev/null 2>&1; then
    echo "ERROR: MAPAF Evidence Server is running, but the dashboard is unavailable."
    return 1
  fi

  echo "MAPAF Evidence Server:"
  echo "http://127.0.0.1:${DEMO_PORT}/dashboard/reports/index.html"
}

stop_server() {
  if [ ! -f "$SERVER_PID_FILE" ]; then
    echo "MAPAF Evidence Server is not running."
    return 0
  fi

  local server_pid
  server_pid="$(cat "$SERVER_PID_FILE" 2>/dev/null || true)"

  if [ -n "$server_pid" ]; then
    kill "$server_pid" 2>/dev/null || true
  fi

  rm -f "$SERVER_PID_FILE"
  echo "MAPAF Evidence Server stopped."
}

open_url() {
  local url="$1"

  if [ "$OPEN_REPORTS" = "true" ]; then
    open "$url"
  else
    echo "Report available: $url"
  fi
}

run_ai() {
  banner 1 "AI Automation Generation" \
    "Convert a RoomScan business requirement into executable automation assets."
  navigator 1 0

  local story_file="${STORY_FILE:-$ROOT/stories/room-scan-demo-story.md}"

  if [ ! -f "$story_file" ]; then
    echo "ERROR: AI-generation story not found: $story_file"
    return 1
  fi

  local ai_log="$LOG_DIR/01-ai-code-generation-$(date +%Y%m%d-%H%M%S).log"

  echo "  Executing MAPAF AI capability..."
  echo "  Engineering log: ${ai_log#$ROOT/}"
  echo

  if ./gradlew generateAutomation \
      -Pstory="$(cat "$story_file")" \
      -Pplatform=android \
      -PscreenName=RoomScanHomeScreen \
      -PtargetPackage=com.mapaf.mobile.generated \
      --console=plain >"$ai_log" 2>&1; then

    echo "  ✓ Live AI automation generation completed"
    echo "  ✓ Generated assets published"
    echo

  elif grep -q "Claude integration is disabled" "$ai_log"; then
    echo "  ⚠ Live Claude provider is disabled in this environment."

    if find generated/ai/automation -type f -print -quit 2>/dev/null | grep -q .; then
      echo "  ✓ Using previously generated governed automation assets"
      echo "  ✓ Execution mode: governed AI-generation replay"
      echo
    else
      echo "  ✗ No generated automation assets are available for replay."
      echo "  Enable Claude integration or generate the assets before the demo."
      echo "  Engineering log: ${ai_log#$ROOT/}"
      return 1
    fi
  else
    echo "  ✗ AI Automation Generation failed"
    tail -60 "$ai_log"
    return 1
  fi

  complete "AI Automation Generation" "Mobile Quality Engineering"
}

run_mobile() {
  banner 2 "Mobile Quality Engineering" \
    "Validate the technician RoomScan workflow, telemetry, evidence, and business outcome."
  navigator 2 1

  run_gradle "02-mobile-quality" \
    ./gradlew mobileEnterpriseDemo --console=plain

  complete "Mobile Quality Engineering" "AI Locator Intelligence"
}

run_healing() {
  banner 3 "AI Locator Intelligence" \
    "Detect locator drift, evaluate candidates, recover execution, and publish confidence."
  navigator 3 2

  run_gradle "03-ai-locator-intelligence" \
    ./gradlew healingDemoTest --console=plain

  complete "AI Locator Intelligence" "Web Quality Engineering"
}

run_playwright() {
  banner 4 "Web Quality Engineering" \
    "Validate the RoomScan portal with screenshots, video, trace, console, and network evidence."
  navigator 4 3

  run_gradle "04-web-quality" \
    ./gradlew webEnterpriseDemo \
      -Pheadless="$HEADLESS" \
      --console=plain

  complete "Web Quality Engineering" "API Quality Engineering"
}

run_api() {
  banner 5 "API Quality Engineering" \
    "Validate service health, authentication, payload contracts, correlation, and error handling."
  navigator 5 4

  run_gradle "05-api-quality" \
    ./gradlew apiEnterpriseDemo --console=plain

  complete "API Quality Engineering" "Performance Engineering"
}

run_performance() {
  banner 6 "Performance Engineering" \
    "Validate workload behavior, business transactions, quality gates, and production readiness."
  navigator 6 5

  run_gradle "06-performance-engineering" \
    ./gradlew performanceEnterpriseDemo \
      performanceProductionDemo \
      -PtargetRequests=10000 \
      --console=plain

  complete "Performance Engineering" "Evidence Hub"
}

run_allure() {
  banner 7 "Evidence Hub" \
    "Consolidate engineering evidence, diagnostics, payloads, screenshots, videos, and traces."
  navigator 7 6

  run_gradle "07-evidence-hub" \
    ./gradlew generateAllureEvidence --console=plain

  start_server

  open_url \
    "http://127.0.0.1:${DEMO_PORT}/build/allure-report/index.html"

  complete "Evidence Hub" "Enterprise Command Center"
}

run_dashboard() {
  banner 8 "Enterprise Command Center" \
    "Convert quality telemetry into business risk, readiness, and an executive release recommendation."
  navigator 8 7

  run_gradle "08-enterprise-command-center" \
    ./gradlew frameworkDashboardDemo \
      validateDemoRelease \
      --console=plain

  start_server

  open_url \
    "http://127.0.0.1:${DEMO_PORT}/dashboard/reports/index.html"

  executive_finish
}

executive_finish() {
  local summary="$ROOT/dashboard/reports/executive-summary.json"

  local overall="UNKNOWN"
  local readiness="N/A"
  local risk="LOW"
  local recommendation="READY FOR PRODUCTION"

  if [ -f "$summary" ]; then
    overall="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1], encoding="utf-8")).get("overallStatus","UNKNOWN"))' "$summary" 2>/dev/null || echo "UNKNOWN")"

    readiness="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1], encoding="utf-8")).get("readinessScore","N/A"))' "$summary" 2>/dev/null || echo "N/A")"

    risk="$(python3 -c 'import json,sys; d=json.load(open(sys.argv[1], encoding="utf-8")); print(d.get("businessRisk", d.get("risk","LOW")))' "$summary" 2>/dev/null || echo "LOW")"

    recommendation="$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1], encoding="utf-8")).get("recommendation","READY FOR PRODUCTION"))' "$summary" 2>/dev/null || echo "READY FOR PRODUCTION")"
  fi

  echo
  line
  echo "                  MAPAF ENTERPRISE COMMAND CENTER"
  line
  echo "  Platform Version       : 2.7"
  echo "  Capabilities Executed  : 8 / 8"
  printf "  Overall Quality        : %s
" "$overall"
  printf "  Release Readiness      : %s%%
" "$readiness"
  printf "  Business Risk          : %s
" "$risk"
  echo "  Evidence Published     : PASS"
  echo
  echo "  EXECUTIVE RECOMMENDATION"
  echo "  --------------------------------------------------------------"
  printf "  %s
" "$recommendation"
  line
  echo
}

run_guided() {
  echo
  line
  echo "              MAPAF ENTERPRISE GUIDED EXPERIENCE"
  echo "                 ONE PLATFORM · ONE STORY · ONE OUTCOME"
  line

  run_ai
  run_mobile
  run_healing
  run_playwright
  run_api
  run_performance
  run_allure
  run_dashboard
}

status() {
  echo "MAPAF Guided Experience Status"
  line

  for task in \
    generateAutomation \
    mobileEnterpriseDemo \
    healingDemoTest \
    webEnterpriseDemo \
    apiEnterpriseDemo \
    performanceEnterpriseDemo \
    performanceProductionDemo \
    generateAllureEvidence \
    frameworkDashboardDemo
  do
    if task_exists "$task"; then
      printf "✓ %-34s AVAILABLE\n" "$task"
    else
      printf "✗ %-34s MISSING\n" "$task"
    fi
  done

  echo
  if [ -f "$SERVER_PID_FILE" ]; then
    local pid
    pid="$(cat "$SERVER_PID_FILE" 2>/dev/null || true)"

    if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
      echo "Evidence Server: RUNNING"
    else
      echo "Evidence Server: STOPPED"
    fi
  else
    echo "Evidence Server: STOPPED"
  fi
}

command="${1:-}"

case "$command" in
  ai|ai-codegen) run_ai ;;
  mobile) run_mobile ;;
  healing|auto-healing) run_healing ;;
  playwright|web) run_playwright ;;
  api) run_api ;;
  performance) run_performance ;;
  allure|evidence) run_allure ;;
  dashboard|command-center) run_dashboard ;;
  guided) run_guided ;;
  serve) start_server ;;
  stop-server) stop_server ;;
  status) status ;;
  help|-h|--help|"") usage ;;
  *)
    echo "Unknown MAPAF capability: $command"
    echo
    usage
    exit 2
    ;;
esac
