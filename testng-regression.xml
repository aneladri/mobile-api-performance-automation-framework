<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Regression Automation Suite">

    <listeners>
        <listener class-name="core.listeners.TestListener"/>
    </listeners>

    <test name="API Regression Tests">
        <packages>
            <package name="api.tests"/>
        </packages>
    </test>

    <test name="Mobile Regression Tests">
        <packages>
            <package name="mobile.tests"/>
        </packages>
    </test>

</suite>